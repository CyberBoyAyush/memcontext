# MemContext MCP Server Environment Variables
# Copy this file to .env and fill in your values

# API Connection
MEMCONTEXT_API_URL=http://localhost:3000
MEMCONTEXT_API_KEY=mc_...

# Public MCP endpoint used to validate OAuth token audience (HTTP server only).
# Must match the API's MCP_SERVER_URL. Falls back to the request Host if unset.
MCP_SERVER_URL=http://localhost:3001/mcp
